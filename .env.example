# Copy to .env and fill in. .env is gitignored; never commit real credentials.
# The same file drives local development and `docker compose --env-file .env`.

# --- Database -------------------------------------------------------------
# For local development with `pnpm db` (embedded Postgres) use localhost.
# For docker compose, the host is the service name: postgres.
DATABASE_URL=postgres://easycal:easycal@localhost:5432/easycal

# Only used by docker compose, to initialise the Postgres container.
POSTGRES_USER=easycal
POSTGRES_PASSWORD=easycal
POSTGRES_DB=easycal

# --- Telegram (MTProto user client) ---------------------------------------
# Create an application at https://my.telegram.org/apps to get these.
# Required in production by both the API and the worker.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Secrets --------------------------------------------------------------
# 32-byte key, base64. Encrypts telegram_connections.encrypted_session (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored Telegram session unreadable and forces everyone
# to reconnect, so keep it backed up.
SESSION_ENCRYPTION_KEY=

# Signs app session tokens issued after a successful Telegram login.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=

# --- API ------------------------------------------------------------------
API_PORT=3000
LOG_LEVEL=info

# Browser origins allowed to call this API with credentials (comma separated).
# apps/web runs on a different origin, so it must be listed here. In production
# this is your deployed web origin, e.g. https://easycal.example.workers.dev
WEB_ORIGINS=http://localhost:3001,http://localhost:5173

# --- Worker ---------------------------------------------------------------
# Extra hours re-fetched on top of folder_selections.lookback_days, so edited
# messages and late replies in a chain are picked up (docs/architecture.md).
SYNC_OVERLAP_HOURS=24

# How often the worker queues a scheduled sync for each active connection.
SYNC_INTERVAL_MINUTES=15

# --- Category classification (optional) -----------------------------------
# Without a key the worker falls back to deterministic keyword matching, so sync
# still works — categories are just less accurate.
OPENAI_API_KEY=
OPENAI_CATEGORY_MODEL=

# --- Web app --------------------------------------------------------------
# Not read from this file: apps/web is built separately and needs this at build
# time. Without it the UI runs on demo data.
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
