# --- Database -------------------------------------------------------------
# Matches infra/docker-compose.yml. node-pg-migrate and both apps read this.
DATABASE_URL=postgres://easycal:easycal@localhost:5432/easycal

# --- Telegram (MTProto user client) ---------------------------------------
# Create an application at https://my.telegram.org/apps to get these.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Secrets --------------------------------------------------------------
# 32-byte key, base64. Encrypts telegram_connections.encrypted_session (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=

# Optional event-category enrichment. Without both values the worker uses its
# deterministic local classifier.
OPENAI_API_KEY=
OPENAI_CATEGORY_MODEL=

# Signs app session tokens issued after a successful Telegram login.
APP_SESSION_SECRET=

# --- Service config -------------------------------------------------------
API_PORT=3000

# Browser origins allowed to call this API with credentials (comma separated).
# apps/web runs on a different origin, so it must be listed here.
WEB_ORIGINS=http://localhost:3001,http://localhost:5173
LOG_LEVEL=info

# Extra hours re-fetched on top of folder_selections.lookback_days, so edited
# messages and late replies in a chain are picked up (docs/architecture.md).
SYNC_OVERLAP_HOURS=24
